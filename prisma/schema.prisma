generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SELLER
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  carts    Cart[]
  orders   Order[]
  products Product[] // Products listed by seller

  @@map("users")
}

model Product {
  id          String        @id @default(uuid())
  sellerId    String        @map("seller_id")
  title       String
  description String
  price       Float
  image       String
  category    String
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([category])
  @@index([status])
  @@map("products")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  status    String     @default("ACTIVE")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
  order Order?

  @@map("carts")
}

model CartItem {
  id          String @id @default(uuid())
  cartId      String @map("cart_id")
  productId   String @map("product_id")
  quantity    Int    @default(1)
  price       Float  // Price at time of adding to cart
  title       String // Product title snapshot
  image       String // Product image snapshot
  category    String // Product category snapshot

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model Order {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  cartId      String   @unique @map("cart_id")
  totalAmount Float    @map("total_amount")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@map("orders")
}
